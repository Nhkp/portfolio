SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-storage-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="cvs"

DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres"
ADMIN_API_KEY="replace-with-a-long-random-secret"
MAX_CV_UPLOAD_BYTES="10485760"

API_URL="http://localhost:8000"

# Optional local Postgres values if you run the compose db service.
POSTGRES_DB="postgres_db"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
